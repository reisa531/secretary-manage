{
  "name": "secretary-manage",
  "version": "1.0.0",
  "description": "团支部管理平台 - 云端 API + 公开站点 + Electron 瘦客户端（管理端）",
  "type": "commonjs",
  "main": "electron/main.js",
  "author": "SecretaryManage",
  "scripts": {
    "electron": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.secretary.manage",
    "productName": "团支部管理平台",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "团支部管理平台"
    }
  }
}
